# Copy to .env for local work, and paste the same values into the Vercel
# project (Settings -> Environment Variables) for Production, Preview and
# Development. Never commit real values.

# ---- Required: Supabase backend (own dashboard -> Settings -> API) ----
# Client side (safe to expose, keep the VITE_ prefix)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
# Server side (never prefix with VITE_)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Admin sign-in (what you type on the /admin screen) ----
# Needed only when no credentials have been saved from the dashboard
# (admin -> Security -> Credentials). Use the same username + password you
# use in Lovable.
OWNER_LOGIN_USERNAME="EagerBeaver"
# Comma separated list, so a password can be rotated without downtime:
OWNER_LOGIN_PASSWORDS="change-me"

# ---- Backing owner account (optional, leave empty) ----
# The server signs into a Supabase auth account to mint your session. Leave
# both empty and the first sign-in provisions a random account automatically
# and stores it in the database. Set them only to pin a specific account.
OWNER_ACCOUNT_EMAIL=""
OWNER_ACCOUNT_PASSWORD=""

# ---- AI workspace (one of the two) ----
# Inside Lovable, LOVABLE_API_KEY is injected automatically and cannot be
# exported. On Vercel use your own OpenAI key (platform.openai.com):
OPENAI_API_KEY=""
# Optional model overrides (defaults: gpt-5.2 text, gpt-image-1-mini images
# on OpenAI; openai/gpt-5.6-sol text on the Lovable gateway):
# AI_TEXT_MODEL="gpt-5.2"
# AI_IMAGE_MODEL="gpt-image-1-mini"

# ---- Optional ----
VITE_SUPABASE_PROJECT_ID="your-project-ref"
