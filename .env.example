# Copy to .env for local work, and paste the same values into the Vercel
# project (Settings -> Environment Variables) for Production, Preview and
# Development. Never commit real values.

# ---- Client (safe to expose, keep the VITE_ prefix) ----
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# ---- Server only (never prefix with VITE_) ----
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Workspace and Image Studio
LOVABLE_API_KEY="provisioned-automatically-on-lovable"

# ---- Admin sign-in (no defaults exist in code, these are required) ----
# What you type on the /admin screen:
OWNER_LOGIN_USERNAME="EagerBeaver"
# Comma separated list, so a password can be rotated without downtime:
OWNER_LOGIN_PASSWORDS="change-me"
# The backing auth account the server signs into after your credentials match:
OWNER_ACCOUNT_EMAIL="you@example.com"
OWNER_ACCOUNT_PASSWORD="a-long-random-string"